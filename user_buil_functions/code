from graphics import rectangle
from graphics import circle
from graphics.graphics_3D import cuboid, sphere

while True:
    print("\n1. Rectangle")
    print("2. Circle")
    print("3. Cuboid")
    print("4. Sphere")
    print("5. Exit")

    a = int(input("Enter your choice: "))

    if a == 1:
        l = int(input("Enter your length: "))
        b = int(input("Enter your breadth: "))
        print("The area of the rectangle =", rectangle.rectanglearea(l, b))
        print("The perimeter of the rectangle =", rectangle.rectangleperimeter(l, b))

    elif a == 2:
        r = int(input("Enter the radius: "))
        print("The area of your circle =", circle.circlearea(r))
        print("The perimeter of your circle =", circle.circleperi(r))

    elif a == 3:
        c = int(input("Enter the length of your cuboid: "))
        d = int(input("Enter the breadth of your cuboid: "))
        e = int(input("Enter the height of your cuboid: "))
        print("The area of your cuboid =", cuboid.cuboidarea(c, d, e))
        print("The perimeter of your cuboid =", cuboid.cuboidperimeter(c, d, e))

    elif a == 4:
        r = int(input("Enter the radius of your sphere: "))
        print("The area of your sphere =", sphere.spherearea(r))
        print("The perimeter of your sphere =", sphere.sphereperimeter(r))

    elif a == 5:
        print("Exiting...")
        break

    else:
        print("Invalid choice, please try again.")
